---
import resume from '../data/resume.json';
const { selectedAchievements } = resume;
---

<section id="achievements">
  <div class="container">
    <span class="section-label">Selected Achievements</span>
    <h2 class="section-title">Impact that defines the work</h2>
    <div class="impact-grid">
      {selectedAchievements.map((item: { title: string; description: string }, i: number) => (
        <div class="card impact-card animate-in" style={`transition-delay: ${i * 80}ms`}>
          <div class="impact-metric">{item.title}</div>
          <div class="impact-description">{item.description}</div>
        </div>
      ))}
    </div>
  </div>
</section>
