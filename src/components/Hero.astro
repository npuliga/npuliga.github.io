---
import resume from '../data/resume.json';
const { executiveSummary, heroMetrics, meta } = resume;
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero-content">
      <p class="hero-eyebrow">{meta.title} · {meta.tagline}</p>
      <h1>{executiveSummary.headline}</h1>
      <p class="hero-description">{executiveSummary.summary}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Get in Touch →</a>
        <a href="#achievements" class="btn btn-secondary">View Achievements</a>
        <a href="/resume.pdf" class="btn btn-secondary" download>Download Resume PDF</a>
      </div>
      <div class="hero-stats">
        {heroMetrics.map((stat: { value: string; label: string }) => (
          <div class="hero-stat">
            <div class="hero-stat-value">{stat.value}</div>
            <div class="hero-stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
