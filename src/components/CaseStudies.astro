---
import resume from '../data/resume.json';
const { executiveSummary } = resume;
---

<section id="expertise">
  <div class="container">
    <span class="section-label">Core Expertise</span>
    <h2 class="section-title">Leadership areas that define my practice</h2>
    <div class="case-studies-grid">
      {executiveSummary.coreLeadershipAreas.map((area: string, i: number) => (
        <div class="card case-study-card animate-in" style={`transition-delay: ${i * 80}ms`}>
          <h3>{area}</h3>
        </div>
      ))}
    </div>
  </div>
</section>
