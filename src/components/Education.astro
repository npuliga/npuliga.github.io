---
import resume from '../data/resume.json';

interface EducationItem {
  degree: string;
  institution: string;
  score?: string;
  focus?: string;
}

interface ProfessionalCert {
  name: string;
  issuer: string;
  issueDate: string;
  expiryDate?: string;
  credlyUrl?: string;
}

interface CertificationsData {
  professional: ProfessionalCert[];
  courses_redhat: string[];
  courses_oreilly: string[];
  legacy: string[];
}

const { education, certifications } = resume;
const certs = certifications as unknown as CertificationsData;
---

<section id="education">
  <div class="container">
    <span class="section-label">Education & Certifications</span>
    <h2 class="section-title">Academic credentials & professional recognition</h2>

    <div class="education-grid">
      {(education as EducationItem[]).map((edu, i) => (
        <div class="card education-card animate-in" style={`transition-delay: ${i * 80}ms`}>
          <div class="degree">{edu.degree}</div>
          <div class="institution">{edu.institution}</div>
          {edu.score && <div class="score">{edu.score}</div>}
          {edu.focus && <div class="focus">{edu.focus}</div>}
        </div>
      ))}
    </div>

    <h3 style="margin-top: var(--space-2xl); margin-bottom: var(--space-lg); font-size: 1.3rem; color: var(--color-accent);">Professional Certifications</h3>
    <div class="certifications-professional">
      {certs.professional.map((cert, i) => (
        <div class="cert-card animate-in" style={`transition-delay: ${i * 60}ms`}>
          <div class="cert-name">{cert.name}</div>
          <div class="cert-meta">
            <span class="cert-issuer">{cert.issuer}</span>
            {cert.expiryDate && <span class="cert-expiry">{cert.expiryDate}</span>}
          </div>
        </div>
      ))}
    </div>

    <h3 style="margin-top: var(--space-2xl); margin-bottom: var(--space-md); font-size: 1.1rem;">Red Hat Training & Courses <span style="color: var(--color-text-secondary); font-weight: 400;">({certs.courses_redhat.length} courses completed)</span></h3>
    <ul class="certifications-list compact">
      {certs.courses_redhat.map((cert, i) => (
        <li class="animate-in" style={`transition-delay: ${(i * 20) + 500}ms`}>{cert}</li>
      ))}
    </ul>

    <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-md); font-size: 1.1rem;">O'Reilly Media Courses <span style="color: var(--color-text-secondary); font-weight: 400;">({certs.courses_oreilly.length} courses completed)</span></h3>
    <ul class="certifications-list compact">
      {certs.courses_oreilly.map((cert, i) => (
        <li class="animate-in" style={`transition-delay: ${(i * 30) + 700}ms`}>{cert}</li>
      ))}
    </ul>

    <h3 style="margin-top: var(--space-xl); margin-bottom: var(--space-md); font-size: 1.1rem;">Legacy Certifications</h3>
    <ul class="certifications-list">
      {certs.legacy.map((cert, i) => (
        <li class="animate-in" style={`transition-delay: ${(i * 40) + 900}ms`}>{cert}</li>
      ))}
    </ul>
  </div>
</section>
